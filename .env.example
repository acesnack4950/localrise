# 이 파일을 복사해서 .env 파일을 만들고, 진짜 값을 넣으세요. (agent 폴더 안에 둬도 됨)
#   cp .env.example agent/.env
# .env 파일은 .gitignore에 등록되어 있어서 GitHub에 올라가지 않습니다.
# 진짜 값은 슬랙 DM으로만 주고받기. 절대 코드·이슈·PR에 붙여넣지 않기.

# ===== 추천 AI =====
# openai = 주최측 OpenAI 키 사용 / ollama = 내 컴퓨터 qwen2.5:7b
LOCALRISE_LLM=openai
OPENAI_API_KEY=
# 모델을 바꾸고 싶을 때만 (기본 gpt-4o-mini)
# LOCALRISE_OPENAI_MODEL=gpt-4o-mini

# ===== 영상 (나중에) =====
COMFY_CLOUD_API_KEY=
